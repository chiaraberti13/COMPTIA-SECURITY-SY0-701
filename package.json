{
  "name": "comptia-security-sy0-701",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/precompress.ts dist && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:standalone": "esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run lint:md && npm run spellcheck && npm run test",
    "smoke": "tsx scripts/smoke-test.ts",
    "coverage-matrix": "tsx scripts/coverage-matrix.ts",
    "maturity-dashboard": "tsx scripts/maturity-dashboard.ts",
    "framework-mapping": "tsx scripts/framework-mapping.ts",
    "gap-analysis": "tsx scripts/gap-analysis.ts",
    "acronym-coverage": "node --import tsx scripts/acronym-coverage.ts",
    "objective-coverage": "node --import tsx scripts/objective-coverage.ts",
    "inventory-coverage": "node --import tsx scripts/inventory-coverage.ts",
    "spellcheck": "tsx scripts/spellcheck.ts",
    "e2e": "playwright test",
    "e2e:offline": "playwright test offline.spec.ts",
    "lint:md": "node --import tsx scripts/lint-markdown.ts",
    "test:coverage": "vitest run --coverage",
    "build:vercel": "vite build --outDir .vercel/output/static && node --import tsx scripts/build-vercel.ts",
    "smoke:vercel": "node --import tsx scripts/smoke-vercel.ts",
    "smoke:live": "node --import tsx scripts/smoke-live.ts",
    "lab:session": "node --import tsx scripts/lab-session.ts",
    "lab:verify": "node --import tsx scripts/verify-lab-session.ts",
    "datasets:generate": "node --import tsx scripts/generate-study-datasets.ts",
    "test:fuzz": "vitest run tests/securityFuzz.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "^10.6.1",
    "cspell": "10.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.10.2",
    "globals": "^17.12.0",
    "jsdom": "29.1.1",
    "markdownlint": "0.41.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "description": "Bilingual (IT/EN) self-hosted study app for the CompTIA Security+ SY0-701 exam",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "smol-toml": "1.9.0",
    "katex": "0.18.2"
  }
}
